# Conversion tracking. All optional: each tracker loads only when its ID is set.
# Set these in Netlify (Site configuration > Environment variables), then redeploy.

# Google Tag Manager container, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Ads: account ID (AW-XXXXXXXXX) and the label of the "Lead" conversion action
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
